<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <!-- Canonical name: drop-in replacement for the proprietary module. -->
    <AssemblyName>osu.Game.Auth</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1401</NoWarn>
    <Description>Transplanted osu! authentication/token-signing module loader and isolation.</Description>
  </PropertyGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\osu.Game\osu.Game.csproj" />
  </ItemGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="ppy.osu.Framework" Version="2026.1019.0" />
  </ItemGroup>
</Project>
